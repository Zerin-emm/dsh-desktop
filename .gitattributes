# The workflow and the scripts run in Linux containers, so line endings must stay LF whichever
# machine checks this out.
* text=auto eol=lf

*.png binary
*.ico binary
*.jpg binary
*.woff2 binary

# Inno Setup: the editor writes CRLF and the compiler expects the same line endings
# that its own templates use, so this file keeps them in the working tree.
*.iss text eol=crlf